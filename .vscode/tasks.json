{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Web",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "tera-ev-servers",
        "clear": false
      }
    },
    {
      "label": "Run API",
      "type": "shell",
      "command": "npm run build && npm start",
      "options": {
        "cwd": "${workspaceFolder}/apps/api",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "api",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "> api@0.0.0 build",
          "endsPattern": "api listening on port"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "tera-ev-servers",
        "clear": false
      }
    },
    {
      "label": "Run Web and API",
      "dependsOn": ["Run API", "Run Web"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
